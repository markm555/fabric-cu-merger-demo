table 'Combine-Data fact_monthly_kpi'
	lineageTag: 2176b3d8-84e9-4335-911c-b9bada9fee55

	/// Certified KPI. Count of newly funded consumer and small-business loans in the month. Owner: Retail Finance.
	measure 'Loans Booked' = SUM('Combine-Data fact_monthly_kpi'[LoansBooked])
		formatString: #,0
		displayFolder: Certified KPIs
		lineageTag: 4343b08b-e730-4734-9ecb-887c9b34db64

	/// Certified KPI. Month-over-month percentage growth of total deposit balances, averaged across branches. Owner: Treasury Analytics.
	measure 'Avg Deposit Growth %' = AVERAGE('Combine-Data fact_monthly_kpi'[DepositGrowthPct])
		formatString: 0.00
		displayFolder: Certified KPIs
		lineageTag: fd8345b8-9b18-4eca-a009-55d2cb1ba4d0

	/// Certified KPI. Net Promoter Score from post-interaction member surveys (promoters minus detractors), averaged across branches. Owner: Member Experience.
	measure 'Avg NPS' = AVERAGE('Combine-Data fact_monthly_kpi'[NPS])
		formatString: 0.0
		displayFolder: Certified KPIs
		lineageTag: 9095685f-49b5-49bc-8316-4cbdae53231b

	/// Certified KPI. Share of total loan balances 30 or more days past due, all loan products, averaged across branches. One definition for both legacy credit unions. Owner: Enterprise Credit Risk.
	measure 'Delinquency %' = AVERAGE('Combine-Data fact_monthly_kpi'[DelinquencyRatePct])
		formatString: 0.00
		displayFolder: Certified KPIs
		lineageTag: b71816de-4248-497a-b7fe-f4b7176bfc59

	/// Certified KPI. Percent of active members who used at least one digital channel in the month. Owner: Digital Banking.
	measure 'Digital Adoption %' = AVERAGE('Combine-Data fact_monthly_kpi'[DigitalAdoptionPct])
		formatString: 0.0
		displayFolder: Certified KPIs
		lineageTag: f4c4064f-3993-4388-9e50-59405bf36868

	/// Enterprise NPS target. Edit to match your scenario.
	measure 'NPS Target' = 60
		formatString: 0
		displayFolder: Targets
		lineageTag: 61dcd88e-1fe6-466c-b52d-ad9552c8b75b

	/// Monthly deposit growth target, in percent.
	measure 'Deposit Growth Target %' = 2.0
		formatString: 0.00
		displayFolder: Targets
		lineageTag: cc2a3e90-9a4f-4558-aebb-41144340af35

	/// Maximum acceptable delinquency rate, in percent. Lower is better.
	measure 'Delinquency Threshold %' = 2.0
		formatString: 0.00
		displayFolder: Targets
		lineageTag: 6698d745-8167-4443-aaaf-a46d873d14bb

	/// Digital adoption target, in percent.
	measure 'Digital Adoption Target %' = 65
		formatString: 0
		displayFolder: Targets
		lineageTag: 14be7ffe-6947-462b-9b02-9b22bbe6c9f3

	/// A branch needs attention when its latest-month delinquency is above this value.
	measure 'Attention Delinquency %' = 3.5
		formatString: 0.00
		displayFolder: Targets
		lineageTag: 6d9583d9-4c1b-46b6-bb22-6b99cf3f36a5

	/// A branch needs attention when its latest-month NPS is below this value.
	measure 'Attention NPS' = 35
		formatString: 0
		displayFolder: Targets
		lineageTag: 45aa3b1b-9c6d-49be-b374-abcc8709cc38

	/// Difference between NPS and its target. Positive is good.
	measure 'NPS vs Target' = [Avg NPS] - [NPS Target]
		formatString: +0.0;-0.0;0.0
		displayFolder: Scorecard
		lineageTag: fc40f66e-afe6-4a56-9e42-b7b1c73f1cc1

	/// Difference between deposit growth and its target. Positive is good.
	measure 'Deposit Growth vs Target' = [Avg Deposit Growth %] - [Deposit Growth Target %]
		formatString: +0.00;-0.00;0.00
		displayFolder: Scorecard
		lineageTag: de8d411c-56a8-4939-8b26-022bf0149255

	/// Difference between delinquency and its threshold. Negative is good.
	measure 'Delinquency vs Threshold' = [Delinquency %] - [Delinquency Threshold %]
		formatString: +0.00;-0.00;0.00
		displayFolder: Scorecard
		lineageTag: 03cff055-bd0a-46a6-9f58-6251de316c9c

	/// Difference between digital adoption and its target. Positive is good.
	measure 'Digital Adoption vs Target' = [Digital Adoption %] - [Digital Adoption Target %]
		formatString: +0.0;-0.0;0.0
		displayFolder: Scorecard
		lineageTag: c6e46ceb-374c-41ed-9034-a878d7f9c1bb

	/// Green at or above target, amber within 10 percent, red otherwise.
	measure 'NPS Status Color' = ```
			VAR v = [Avg NPS]
			VAR t = [NPS Target]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), BLANK(),
			        v >= t, "#2E8B57",
			        v >= t * 0.9, "#D98E04",
			        "#C0392B"
			    )
			```
		displayFolder: Scorecard\Formatting
		lineageTag: 455192cc-7535-484f-a170-83f97635a533

	/// Green at or above target, amber within 25 percent, red otherwise.
	measure 'Deposit Growth Status Color' = ```
			VAR v = [Avg Deposit Growth %]
			VAR t = [Deposit Growth Target %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), BLANK(),
			        v >= t, "#2E8B57",
			        v >= t * 0.75, "#D98E04",
			        "#C0392B"
			    )
			```
		displayFolder: Scorecard\Formatting
		lineageTag: ebe6d432-67db-43c6-959c-2c2a35f917b5

	/// Green at or above target, amber within 10 percent, red otherwise.
	measure 'Digital Adoption Status Color' = ```
			VAR v = [Digital Adoption %]
			VAR t = [Digital Adoption Target %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), BLANK(),
			        v >= t, "#2E8B57",
			        v >= t * 0.9, "#D98E04",
			        "#C0392B"
			    )
			```
		displayFolder: Scorecard\Formatting
		lineageTag: e0ed81f4-8b5a-46bf-b264-9a6bcd49b404

	/// Green at or below threshold, amber up to 25 percent over, red otherwise.
	measure 'Delinquency Status Color' = ```
			VAR v = [Delinquency %]
			VAR t = [Delinquency Threshold %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(v), BLANK(),
			        v <= t, "#2E8B57",
			        v <= t * 1.25, "#D98E04",
			        "#C0392B"
			    )
			```
		displayFolder: Scorecard\Formatting
		lineageTag: 32cb235a-308a-4e3e-a3f5-d6bad3c8b909

	/// Branches whose latest-month delinquency or NPS crosses the attention thresholds. Respects row-level security.
	measure 'Branches Needing Attention' = ```
			VAR LastMonth = MAX('Combine-Data fact_monthly_kpi'[MonthStart])
			VAR Flagged =
			    FILTER(
			        VALUES('Combine-Data dim_branch'[SourceBranchKey]),
			        VAR d = CALCULATE([Delinquency %], 'Combine-Data fact_monthly_kpi'[MonthStart] = LastMonth)
			        VAR n = CALCULATE([Avg NPS], 'Combine-Data fact_monthly_kpi'[MonthStart] = LastMonth)
			        RETURN NOT ISBLANK(d) && (d > [Attention Delinquency %] || n < [Attention NPS])
			    )
			RETURN
			    COUNTROWS(Flagged) + 0
			```
		formatString: 0
		displayFolder: Scorecard
		lineageTag: 2ac2635b-f5d6-47ff-912d-770ecc7d0743

	/// Branch delinquency minus the average across all branches the user can see.
	measure 'Branch Delinquency vs Enterprise' = [Delinquency %] - CALCULATE([Delinquency %], REMOVEFILTERS('Combine-Data dim_branch'))
		formatString: +0.00;-0.00;0.00
		displayFolder: Drill-through
		lineageTag: 4c62d414-476f-4374-88e0-ca49f651a48c

	/// Branch NPS minus the average across all branches the user can see.
	measure 'Branch NPS vs Enterprise' = [Avg NPS] - CALCULATE([Avg NPS], REMOVEFILTERS('Combine-Data dim_branch'))
		formatString: +0.0;-0.0;0.0
		displayFolder: Drill-through
		lineageTag: def5f78e-ccee-40e2-bfc9-61d741712820

	/// Latest month in the current selection.
	measure 'Data As Of' = "Data as of " & FORMAT(MAX('Combine-Data fact_monthly_kpi'[MonthStart]), "MMMM yyyy")
		displayFolder: Labels
		lineageTag: d0854c47-164c-4a3f-971a-423bd7de1f6c

	/// Subtitle that names the legacy credit union in view.
	measure 'Report Subtitle' = ```
			VAR cu =
			    IF(
			        HASONEVALUE('Combine-Data dim_branch'[SourceCU]),
			        VALUES('Combine-Data dim_branch'[SourceCU]),
			        "Contoso CU + Fabrikam CU (combined)"
			    )
			RETURN
			    cu & "  |  Certified KPIs  |  " & [Data As Of]
			```
		displayFolder: Labels
		lineageTag: f6f135b0-254e-4f25-a45e-fd4d09e82386

