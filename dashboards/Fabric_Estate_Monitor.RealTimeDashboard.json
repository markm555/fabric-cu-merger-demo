      },
      "text": "EstateInventory()\n| summarize Items = count() by ItemKind\n| top 15 by Items\n",
      "id": "cf58a881-e299-59d2-b15a-678d9acea8d0",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateItemChanges(_startTime)\n| where EventTime <= _endTime and Change != \"Baseline\"\n| order by EventTime desc\n| project EventTime, Change, Scope, ItemName, ItemKind, WorkspaceName, ChangedBy, ChangedFields, Origin\n| take 200\n",
      "id": "bb30e36a-ba86-5efb-ad61-c5d962937c8f",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateInventory()\n| summarize Items = count(), Reports = countif(ItemKind == \"Report\"), SemanticModels = countif(ItemKind == \"SemanticModel\"),\n            Lakehouses = countif(ItemKind == \"Lakehouse\"), Warehouses = countif(ItemKind == \"Warehouse\"),\n            Notebooks = countif(ItemKind == \"Notebook\"), Pipelines = countif(ItemKind == \"DataPipeline\"),\n            LastChange = max(LastUpdated) by WorkspaceName\n| order by Items desc\n",
      "id": "a2740edf-2100-5e81-8bee-6f69e9c22756",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "let userAdmins = EstateAccessCurrent()\n    | where Role == \"Admin\" and PrincipalType == \"User\"\n    | summarize UserAdmins = count() by WorkspaceId;\nEstateWorkspaces()\n| where WorkspaceType !~ \"Personal\" and State !~ \"Deleted\"\n| join kind=leftouter userAdmins on WorkspaceId\n| where isnull(UserAdmins)\n| project WorkspaceName, WorkspaceId, State, LastSeen\n",
      "id": "7d6d8279-e97b-58da-bd34-cbb6ce0fb9b4",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "RawEvents\n| where ingestion_time() > ago(1h)\n| summarize Events = count(), Latest = max(['time']),\n            AvgIngestLagSec = round(avg(datetime_diff(\"second\", ingestion_time(), ['time'])), 0) by type, source\n| order by Latest desc\n",
      "id": "a2a19272-d1e7-5fc7-9f97-91308981f2fb",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "RawEvents\n| where ['time'] between (_startTime .. _endTime)\n| extend Stream = case(type startswith \"Microsoft.Fabric.Capacity\", \"Capacity events\",\n                       type contains \"ItemJob\", \"Job events\",\n                       type startswith \"Microsoft.Fabric.Item\", \"Item events\",\n                       source has \"simulator\", \"Simulator\",\n                       \"Collector\")\n| summarize Events = count() by bin(['time'], 1m), Stream\n| order by ['time'] asc\n",
      "id": "a7bae016-e023-5b2d-9924-010eb1691255",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCollectorHealth(_startTime)\n| where EventTime <= _endTime\n| order by EventTime desc\n| project EventTime, Kind, Collector, EventsSent, DurationSec, IngestLagSec, Message\n| take 200\n",
      "id": "057d1fd5-1ca4-57c6-91dc-ef5df2b30871",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    }
  ]
}