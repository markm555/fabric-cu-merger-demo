  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCapacity(ago(15m))\n| summarize arg_max(WindowStart, UtilizationPct) by CapacityId\n| summarize UtilizationPct = max(UtilizationPct)\n",
      "id": "dd06e8c8-777e-5ca9-8233-9c2b7dd470ae",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCapacityState(ago(30d))\n| summarize arg_max(TransitionTime, CapacityState, Reason) by CapacityId\n| summarize Overloaded = countif(CapacityState =~ \"Overloaded\" or Reason in~ (\"InteractiveDelay\", \"InteractiveRejection\", \"BackgroundRejection\"))\n| project Status = iff(Overloaded > 0, strcat(Overloaded, \" overloaded\"), \"Healthy\")\n",
      "id": "61c2aae9-fd3a-589f-8bd4-67435e26c4ff",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateJobsLatest(ago(1d))\n| where Status == \"InProgress\"\n| count\n",
      "id": "f8c2c172-e8e6-5ae3-ba89-1ec0155e2e27",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateJobsLatest(_startTime)\n| where EventTime between (_startTime .. _endTime) and Status == \"Failed\"\n| count\n",
      "id": "000ed588-2a94-57f7-a2d0-d7741ffc0451",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(ago(15m))\n| summarize Users = dcount(User)\n",
      "id": "108037b8-f263-58db-aa53-933b68be36a5",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "RawEvents\n| where ingestion_time() > ago(5m)\n| summarize EventsPerMinute = round(count() / 5.0, 1)\n",
      "id": "770ba133-251c-5ea0-adcd-84667f5b150a",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCapacity(_startTime)\n| where WindowStart between (_startTime .. _endTime)\n| project WindowStart, CapacityName, UtilizationPct\n| order by WindowStart asc\n",
      "id": "cd25a51f-e306-55bc-b56d-80d358aecbe8",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCapacity(_startTime)\n| where WindowStart between (_startTime .. _endTime)\n| summarize InteractiveDelay = max(InteractiveDelayPct), InteractiveRejection = max(InteractiveRejectPct),\n            BackgroundRejection = max(BackgroundRejectPct) by WindowStart\n| order by WindowStart asc\n",
      "id": "ca6261fa-7d93-52f8-86c1-e9ca75b840fb",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateJobsLatest(_startTime)\n| where EventTime <= _endTime\n| order by EventTime desc\n| project EventTime, Status, ItemName, ItemKind, WorkspaceName, JobType, InvokeType, DurationSec, Origin, ErrorMessage\n| take 100\n",
      "id": "88c76f3b-505a-50b7-be53-84adee6081f0",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateJobsLatest(_startTime)\n| where StartTime between (_startTime .. _endTime)\n| summarize Jobs = count() by bin(StartTime, 5m), Status\n| order by StartTime asc\n",
      "id": "a974036f-04d5-5b91-8755-8c36c6baa10d",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCapacityOperations(_startTime)\n| where EventTime between (_startTime .. _endTime)\n| summarize CUSeconds = round(sum(CUms) / 1000.0, 1), Operations = count(),\n            ThrottledOperations = countif(ThrottlingDelayMs > 0), Users = dcount(Identity)\n          by WorkspaceName, ItemName, ItemKind\n| top 15 by CUSeconds\n",
      "id": "caebae25-b3e0-59e0-987c-92a1400ce083",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateCapacity(_startTime)\n| where WindowStart between (_startTime .. _endTime)\n| summarize Interactive = sum(InteractiveCUms) / 1000.0, Background = sum(BackgroundCUms) / 1000.0 by WindowStart\n| order by WindowStart asc\n",
      "id": "16e5002f-7171-5192-b32f-11b1e7840880",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime\n| summarize Users = dcount(User)\n",
      "id": "391c7a1f-eb74-5a62-9d52-bbdab356385e",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and Category == \"Viewing and querying\"\n| count\n",
      "id": "10f6d619-dc7e-5259-b595-d7f8806b4297",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and Category == \"AI and Copilot\"\n| count\n",
      "id": "2d6ad9fe-0cfe-53b2-99d3-40ba45166e4f",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and Category == \"Export and download\"\n| count\n",
      "id": "0cce678d-dd33-511e-85c3-f26d1801bb10",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateAccessChanges(_startTime)\n| where EventTime <= _endTime and Change != \"Baseline\"\n| count\n",
      "id": "97daab44-11c0-5efa-8842-33e99b0f0d69",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and IsSuccess == false\n| count\n",
      "id": "e00c5817-284d-5580-81a5-346f8c61ad21",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime\n| summarize Events = count() by bin(EventTime, 1m), Category\n| order by EventTime asc\n",
      "id": "2e9896c6-3a56-5427-b5c8-81eefa467dec",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and Category == \"Viewing and querying\" and isnotempty(ItemName)\n| summarize Views = count() by ItemName\n| top 10 by Views\n",
      "id": "1cfae21c-71fe-57a8-86d2-8918a6a601d0",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and Category == \"Export and download\"\n| summarize Exports = count(), Items = dcount(ItemName), First = min(EventTime), Last = max(EventTime) by User\n| extend Flag = iff(Exports >= 10, \"Investigate\", \"\")\n| order by Exports desc\n",
      "id": "35b91556-2cad-5850-b7cb-2d6cee5a2ce4",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime and Category == \"AI and Copilot\"\n| order by EventTime desc\n| project EventTime, User, Activity, ItemName, WorkspaceName\n| take 100\n",
      "id": "7c780f59-c1e4-598b-9728-9b5c90aa5300",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateAccessChanges(_startTime)\n| where EventTime <= _endTime and Change != \"Baseline\"\n| extend Attention = iff(Role == \"Admin\" and Change in (\"Granted\", \"RoleChanged\"), \"New admin\", \"\")\n| order by EventTime desc\n| project EventTime, Attention, Change, WorkspaceName, Principal, PrincipalType, Role, PreviousRole\n",
      "id": "0ab788c3-510a-5e1d-9231-691abfacb58f",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateActivity(_startTime)\n| where EventTime <= _endTime\n| order by EventTime desc\n| project EventTime, User, Activity, Category, ItemName, WorkspaceName, ClientApp, IsSuccess\n| take 200\n",
      "id": "32cd196a-7b7b-5310-9c8e-411e7be0dfa6",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateInventory()\n| count\n",
      "id": "75aea702-20be-5e64-9846-28cd5c1b5cff",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateWorkspaces()\n| where WorkspaceType !~ \"Personal\"\n| count\n",
      "id": "22903388-5407-5d82-b20e-2e706aad115c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateItemChanges(_startTime)\n| where EventTime <= _endTime and Change != \"Baseline\"\n| count\n",
      "id": "3c5e8281-9979-53cc-a3c7-1d8430092f28",
      "usedVariables": [
        "_endTime",
        "_startTime"
      ]
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "bef59065-7212-5ded-8a15-bfa1aff86f69"
      },
      "text": "EstateItemChanges(_startTime)\n| where EventTime <= _endTime and Change == \"Deleted\"\n| count\n",
      "id": "e5eed53a-1466-53ab-a2ce-fd851f3765b9",
      "usedVariables": [
